{
  "firestore": { "rules": "firestore.rules" },
  "hosting": {
    "public": "_site",
    "cleanUrls": true,
    "ignore": ["**/.*"],
    "headers": [
      { "source": "**/*.@(js|css|html)", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
      { "source": "**/*.apk", "headers": [{ "key": "Content-Type", "value": "application/vnd.android.package-archive" }] }
    ]
  }
}
