{
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": {
    "public": "_site",
    "cleanUrls": true,
    "ignore": [
      "**/.*",
      "**/*.apk"
    ],
    "headers": [
      {
        "source": "**/*.@(js|css|html)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      }
    ],
    "redirects": [
      {
        "source": "/dawri-alhikma.apk",
        "destination": "https://mohamedfayzyasenalsabagh-create.github.io/dawri-alhikma/dawri-alhikma.apk",
        "type": 302
      }
    ]
  }
}