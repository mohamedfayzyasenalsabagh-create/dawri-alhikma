rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // الكل بيقرأ الدوري، والتعديل بس لحساب المشرف
    match /league/{doc} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.token.email == "ADMIN_EMAIL";
    }
  }
}
